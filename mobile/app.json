{
  "expo": {
    "name": "BioPrecision",
    "slug": "bioprecision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bioprecision",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF7F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brickerd.bioprecision",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#C96A2B"
      },
      "package": "com.brickerd.bioprecision"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23880ad4-c7af-4860-8d52-4adfc1ada5a5"
      }
    },
    "owner": "bp-beta"
  }
}
